# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://backtrack:backtrack@127.0.0.1:5433/backtrack

# Production only — comma-separated list of allowed frontend origins.
# Leave unset locally: falls back to "*", which local dev and curl rely on.
# ALLOWED_ORIGINS=https://backtrack-planner.web.app,https://backtrack-planner.firebaseapp.com

# Production only — required by Cloud Run/Render/etc, injected by the platform. Do not set locally.
# PORT=8080

# Set only when intentionally seeding a non-local database (backend/src/db/seed.ts truncates tables).
# ALLOW_REMOTE_SEED=true

# Frontend build-time only (Vite). Leave unset locally: falls back to relative paths via the dev proxy.
# VITE_API_BASE_URL=https://backtrack-api-xxxxxxxx.us-east4.run.app
